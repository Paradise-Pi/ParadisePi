{
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit",
		"editor.formatOnSave": "explicit",
		"source.organizeImports": "explicit"
	},
	"eslint.validate": ["javascript", "typescript", "typescriptreact"],
	"cSpell.language": "en-GB",
	"cSpell.words": [
		"Behringer",
		"clsx",
		"Colour",
		"Crestron",
		"Gilles",
		"Logline",
		"Mantine",
		"maxsize",
		"Millis",
		"paradisepi",
		"portfinder",
		"postfade",
		"prefade",
		"qrcode",
		"tagline",
		"tailable",
		"typeorm",
		"undefinedbuild",
		"xair",
		"xremote"
	],
	"editor.wordWrap": "on",
	"files.eol": "\n"
}
