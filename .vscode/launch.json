{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run & Debug Client",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceRoot}/client",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev"],
			"preLaunchTask": "NPM Install - Client"
		},
		{
			"name": "Run & Debug Server",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceRoot}/server",
			"env": {
				"NODE_ENV": "development",
				"PARADISE_LOG_PATH": "${workspaceRoot}/serverDevLogs",
				"PARADISE_IMAGE_PATH": "${workspaceRoot}/serverDevImages",
				"PARADISE_DATABASE_PATH": "${workspaceRoot}/paradise-development-database.sqlite"
			},
			"outputCapture": "std",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "develop"],
			"preLaunchTask": "NPM Install - Server"
		},
		{
			"name": "Run & Debug Docs",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceRoot}/docs",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "start"],
			"preLaunchTask": "NPM Install - Docs"
		}
	]
}
